p15 = plot(LJN_26m.UTC_Date___Time, LJN_26m.Temp_C_cleaned, 'm-', 'LineWidth', 1.0);
p16 = plot(LJS_16m.UTC_Date___Time, LJS_16m.Temp_C_cleaned, 'g-', 'LineWidth', 1.0);
p17 = plot(LJS_32m.UTC_Date___Time, LJS_32m.Temp_C_cleaned, 'r-', 'LineWidth', 1.0);




