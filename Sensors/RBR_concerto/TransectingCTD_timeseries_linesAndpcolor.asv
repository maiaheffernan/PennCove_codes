    xlabel('Longitude'); ylabel('Latitude'); title('Cast track (colored by time)')

    linkaxes([ax1, ax2, ax3], 'x')
end

%% plot the CTD timeseries with the ADCP velocities

%--- Ebb ---


cmap_sal = cmocean('-haline');
cmap_temp = cmocean('thermal');
cmap_do = cmocean('-matter');
cmap_vel = cmocean('balance');

% column indices within the "values" matrix
col_temp  = 2;
col_depth = 7;
col_sal   = 8;
col_do    = 14;


% the ebb data has data from the previous two trips, so this is the first
% index number that has ONLY the casts from the 22 of July 2026 which is
% the day I want
dayStart = datetime(2026, 7, 22); 

for ii = 1:3   %length(matchedCTD_ebb)
    keepIdx = matchedCTD_ebb(ii).castTimes >= dayStart;

    casts     = matchedCTD_ebb(ii).casts(keepIdx);
    castTimes = matchedCTD_ebb(ii).castTimes(keepIdx);
    nCasts    = length(casts);

    adcpTimes = datetime([ADCP_data_ebb.lapData(ii).time], 'ConvertFrom', 'datenum');

    % --- preallocate matrices for easy calling in the plot ---
    nRows   = size(casts(1).values, 1); % 560
    salMat  = NaN(nRows, nCasts);
    tempMat = NaN(nRows, nCasts);
    doMat   = NaN(nRows, nCasts);
    lonVals = NaN(1, nCasts);
    latVals = NaN(1, nCasts);

    eastVelVals = (ADCP_data_ebb.lapData(ii).eastVel_corrected);
    northVelVals = (ADCP_data_ebb.lapData(ii).northVel_corrected);
    ADCP_depth = (ADCP_data_ebb.lapData(ii).binDepth);
    ADCP_bottomTrack = (ADCP_data_ebb.lapData(ii).bottomTrack);

    for m = 1:nCasts
        tempMat(:, m) = casts(m).values(:, col_temp);
        salMat(:, m)  = casts(m).values(:, col_sal);
        doMat(:, m)   = casts(m).values(:, col_do);
        lonVals(m)    = casts(m).lon;
        latVals(m)    = casts(m).lat;
    end

    depthVec = casts(1).values(:, col_depth); 

    % --- plot ---
    figure(ii)

    s1 = subplot(6,1,1);
    pcolor(castTimes, depthVec, tempMat); shading flat
    set(s1, 'YDir', 'reverse')
    colormap(s1, cmap_temp); colorbar
    ylabel('Depth (m)'); title(sprintf('July 22, 2024 ebb line %d: Temperature (deg C)', ii))

    s2 = subplot(6,1,2);
    pcolor(castTimes, depthVec, salMat); shading flat
    set(s2, 'YDir', 'reverse')
    colormap(s2, cmap_sal); colorbar
    clim([6 25])
    ylabel('Depth (m)'); title('Salinity (PSU)')

    s3 = subplot(6,1,3);
    pcolor(castTimes, depthVec, doMat); shading flat
    set(s3, 'YDir', 'reverse')
    colormap(s3, cmap_do); colorbar
    ylabel('Depth (m)'); title('Dissolved Oxygen (mg/L)')


    
    s4 = subplot(6,1,4);
    pcolor(adcpTimes, ADCP_depth, eastVelVals'); shading flat
    set(s4, 'YDir', 'reverse')
    colormap(s4, cmap_vel); colorbar; clim([-0.5 0.5]);
    ylabel('Depth (m)'); title('East/west velocities (m/s)')
    hold on 
    plot(adcpTimes, ADCP_bottomTrack, 'k-');
    grid off;


    s5 = subplot(6,1,5);
    pcolor(adcpTimes, ADCP_depth, northVelVals'); shading flat
    set(s5, 'YDir', 'reverse')
    colormap(s5, cmap_vel); colorbar; clim([-0.5 0.5]);
    ylabel('Depth (m)'); title('North/South velocities (m/s)')
    hold on 
    plot(adcpTimes, ADCP_bottomTrack, 'k-');
    grid off;


    s6 = subplot(6,1,6);
    colorVals = minutes(castTimes - castTimes(1)); % elapsed seconds since first cast in this line
    scatter(lonVals, latVals, 60, colorVals, 'filled')
    colormap(s6, parula)
    cb = colorbar;
    cb.Label.String = 'Time elapsed since start of lap (s)';
    xlim([-122.75 -122.63])
    ylim([48.22 48.24])
    xlabel('Longitude'); ylabel('Latitude'); title('Cast track (colored by time)')

end


%% ---- Flood -----

%--- Ebb ---


cmap_sal = cmocean('-haline');
cmap_temp = cmocean('thermal');
cmap_do = cmocean('-matter');
cmap_vel = cmocean('balance');

% column indices within the "values" matrix
col_temp  = 2;
col_depth = 7;
col_sal   = 8;
col_do    = 14;


% the ebb data has data from the previous two trips, so this is the first
% index number that has ONLY the casts from the 22 of July 2026 which is
% the day I want
dayStart = datetime(2026, 7, 22); 


for ii = 1:7        %length(matchedCTD_flood)
    keepIdx = matchedCTD_flood(ii).castTimes >= dayStart;
    casts     = matchedCTD_flood(ii).casts(keepIdx);
    castTimes = matchedCTD_flood(ii).castTimes(keepIdx);
    nCasts    = length(casts);

    if nCasts == 0
        continue % nothing to plot for this line
    end

    % --- preallocate matrices for easy calling in the plot ---
    nRows   = size(casts(1).values, 1); % 560
    salMat  = NaN(nRows, nCasts);
    tempMat = NaN(nRows, nCasts);
    doMat   = NaN(nRows, nCasts);
    lonVals = NaN(1, nCasts);
    latVals = NaN(1, nCasts);

    for m = 1:nCasts
        tempMat(:, m) = casts(m).values(:, col_temp);
        salMat(:, m)  = casts(m).values(:, col_sal);
        doMat(:, m)   = casts(m).values(:, col_do);
        lonVals(m)    = casts(m).lon;
        latVals(m)    = casts(m).lat;
    end
    depthVec = casts(1).values(:, col_depth);


    eastVelVals = (ADCP_data_flood.lapData(ii).eastVel_corrected);
    northVelVals = (ADCP_data_flood.lapData(ii).northVel_corrected);
    ADCP_depth = (ADCP_data_flood.lapData(ii).binDepth);
    ADCP_bottomTrack = (ADCP_data_flood.lapData(ii).bottomTrack);


    % --- plot ---
    figure(ii)

    s1 = subplot(6,1,1);
    pcolor(castTimes, depthVec, tempMat); shading flat
    set(s1, 'YDir', 'reverse')
    colormap(s1, cmap_temp); colorbar
    ylabel('Depth (m)'); title(sprintf('July 22, 2024 ebb line %d: Temperature (deg C)', ii))

    s2 = subplot(6,1,2);
    pcolor(castTimes, depthVec, salMat); shading flat
    set(s2, 'YDir', 'reverse')
    colormap(s2, cmap_sal); colorbar
    clim([6 25])
    ylabel('Depth (m)'); title('Salinity (PSU)')

    s3 = subplot(6,1,3);
    pcolor(castTimes, depthVec, doMat); shading flat
    set(s3, 'YDir', 'reverse')
    colormap(s3, cmap_do); colorbar
    ylabel('Depth (m)'); title('Dissolved Oxygen (mg/L)')


    
    s4 = subplot(6,1,4);
    pcolor(adcpTimes, ADCP_depth, eastVelVals'); shading flat
    set(s4, 'YDir', 'reverse')
    colormap(s4, cmap_vel); colorbar; clim([-0.5 0.5]);
    ylabel('Depth (m)'); title('East/west velocities (m/s)')
    hold on 
    plot(adcpTimes, ADCP_bottomTrack, 'k-');
    grid off;


    s5 = subplot(6,1,5);
    pcolor(adcpTimes, ADCP_depth, northVelVals'); shading flat
    set(s5, 'YDir', 'reverse')
    colormap(s5, cmap_vel); colorbar; clim([-0.5 0.5]);
    ylabel('Depth (m)'); title('North/South velocities (m/s)')
    hold on 
    plot(adcpTimes, ADCP_bottomTrack, 'k-');
    grid off;


    s6 = subplot(6,1,6);
    colorVals = minutes(castTimes - castTimes(1)); % elapsed seconds since first cast in this line
    scatter(lonVals, latVals, 60, colorVals, 'filled')
    colormap(s6, parula)
    cb = colorbar;
    cb.Label.String = 'Time elapsed since start of lap (s)';
    xlim([-122.75 -122.63])
    ylim([48.22 48.24])
    xlabel('Longitude'); ylabel('Latitude'); title('Cast track (colored by time)')

end
%% plot the flood transect timeseries with the transect line colore by time

cmap_sal  = cmocean('-haline');
cmap_temp = cmocean('thermal');
cmap_do   = cmocean('-matter');

% column indices within the "values" matrix
col_temp  = 2;
col_depth = 7;
col_sal   = 8;
col_do    = 14;

dayStart = datetime(2026, 7, 22); % the day you want

for ii = 1:7        %length(matchedCTD_flood)
    keepIdx = matchedCTD_flood(ii).castTimes >= dayStart;
    casts     = matchedCTD_flood(ii).casts(keepIdx);
    castTimes = matchedCTD_flood(ii).castTimes(keepIdx);
    nCasts    = length(casts);

    if nCasts == 0
        continue % nothing to plot for this line
    end

    % --- preallocate matrices for easy calling in the plot ---
    nRows   = size(casts(1).values, 1); % 560
    salMat  = NaN(nRows, nCasts);
    tempMat = NaN(nRows, nCasts);
    doMat   = NaN(nRows, nCasts);
    lonVals = NaN(1, nCasts);
    latVals = NaN(1, nCasts);

    for m = 1:nCasts
        tempMat(:, m) = casts(m).values(:, col_temp);
        salMat(:, m)  = casts(m).values(:, col_sal);
        doMat(:, m)   = casts(m).values(:, col_do);
        lonVals(m)    = casts(m).lon;
        latVals(m)    = casts(m).lat;
    end
    depthVec = casts(1).values(:, col_depth);

    % --- plot ---
    figure(ii + 10) % offset so flood figures don't overwrite ebb figures (1-3)
    s1 = subplot(4,1,1);
    pcolor(castTimes, depthVec, tempMat); shading flat
    set(s1, 'YDir', 'reverse')
    colormap(s1, cmap_temp); colorbar
    ylabel('Depth (m)'); title(sprintf('July 22, 2024 flood line %d: Temperature', ii))

    s2 = subplot(4,1,2);
    pcolor(castTimes, depthVec, salMat); shading flat
    set(s2, 'YDir', 'reverse')
    colormap(s2, cmap_sal); colorbar
    clim([6 25])
    ylabel('Depth (m)'); title('Salinity')

    s3 = subplot(4,1,3);
    pcolor(castTimes, depthVec, doMat); shading flat
    set(s3, 'YDir', 'reverse')
    colormap(s3, cmap_do); colorbar
    ylabel('Depth (m)'); title('Dissolved Oxygen')

    s4 = subplot(4,1,4);
    colorVals = minutes(castTimes - castTimes(1)); % elapsed minutes since start of lap
    scatter(lonVals, latVals, 60, colorVals, 'filled')
    colormap(s4, parula)
    cb = colorbar;
    cb.Label.String = 'Time elapsed since start of lap (min)';
    xlim([-122.7 -122.63])
    ylim([48.22 48.24])
    xlabel('Longitude'); ylabel('Latitude'); title('Cast track (colored by time)')
end
