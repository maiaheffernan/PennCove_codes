adcp_flood.datetime = datetime([adcp_flood.time], "ConvertFrom", "datenum");


ctd_flood.CTD_flood.datetime = datetime([ctd_flood.CTD_flood.data.tstamp], "ConvertFrom", "datenum");
ctd_flood.CTD_flood.datetime = datetime([ctd_flood.CTD_flood.data.tstamp], "ConvertFrom", "datenum");



